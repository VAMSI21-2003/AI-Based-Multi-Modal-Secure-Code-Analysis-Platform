# Copy to backend/.env (python-dotenv is not currently wired in -- export
# these into your shell, or set them in docker-compose.yml / your process
# manager) and adjust as needed. Every variable below is read somewhere in
# this codebase; nothing here is speculative.

# Comma-separated list of origins allowed to call the API cross-origin,
# e.g. "http://localhost:5173,https://scan.example.com". Falls back to
# http://localhost:5173 and http://127.0.0.1:5173 if unset (matches both
# the Vite dev server and docker-compose.yml's frontend port) -- unchanged
# behavior unless you explicitly set this. See backend/main.py.
CORS_ALLOWED_ORIGINS=

# Overrides where the SQLite platform database lives (default:
# backend/data/platform.db). The test suite (backend/tests/conftest.py)
# always sets this to a throwaway temp file regardless of what's set here,
# so this is only relevant to a real deployment wanting a custom data path
# (e.g. a specific volume mount). See backend/database.py.
SECURECODE_DB_PATH=

# CI-only: whether backend/ci_scan.py's exit code fails the build on a
# CRITICAL finding. Defaults to false (report-only) if unset -- see
# docs/CI_CD.md. Not relevant to running the app itself.
SCAN_BLOCKING=false

# Standard HuggingFace Hub variable (read by the `transformers`/
# `huggingface_hub` libraries themselves, not this codebase directly) --
# set this to raise CodeBERT's download rate limit / speed on first model
# load. Optional; the app works without it (you'll just see a "sending
# unauthenticated requests" warning on cold start).
HF_TOKEN=

# Log level for the app's structured logger (backend/logging_config.py) --
# also affects third-party libraries' own loggers (e.g. httpx/
# huggingface_hub log every HTTP request at INFO during model download).
# Default: INFO. Set to WARNING to quiet the model-download chatter, or
# DEBUG for more detail.
LOG_LEVEL=INFO
