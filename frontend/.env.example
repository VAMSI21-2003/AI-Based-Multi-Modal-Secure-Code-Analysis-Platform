# Copy to .env.local (or .env) and adjust as needed. Vite only reads
# variables prefixed VITE_; a change requires restarting `npm run dev` (or
# rebuilding for production) to take effect.

# Timeout (ms) for scan-triggering requests: single-file scan, batch/ZIP/
# folder upload, GitHub repo scan, and live-editor scan. These can
# legitimately take minutes on a large real-world repo (measured: 186-249s
# for a 200-file GitHub scan) -- default is 10 minutes. This is a stopgap,
# not a real fix: the proper solution for very large repos is an async job
# (submit -> poll status -> fetch result) instead of one long blocking
# request. See README.md "Configuration".
VITE_SCAN_TIMEOUT_MS=600000
