# Python
__pycache__/
*.pyc
venv/
*.egg-info/

# Node
node_modules/
dist/
build/

# Runtime data -- regenerated automatically on first run, must not be committed
backend/data/*.db

# Large regenerable dataset artifacts (regenerate via src/preprocessing,
# src/ast, src/metrics, src/codebert, src/fusion -- see paper/research_paper.md
# Section 4). Not needed at runtime: only models/*.json and models/*.joblib
# are (those ARE committed).
dataset/raw/
dataset/processed/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Env / secrets
.env
.env.*

# Scratch
scratch_shots/

# Generated by backend/ci_scan.py when run locally (CI uploads these as a
# workflow artifact instead of committing them)
security-report.md
security-report.json

# Runtime logs
*.log
